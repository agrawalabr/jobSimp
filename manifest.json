{
  "manifest_version": 3,
  "name": "JobSimp — Job Application Copilot",
  "version": "0.1.0",
  "description": "Google-login job copilot: track applications, AI-parsed multi-resume autofill, JD match scoring, AI outreach emails via Gmail.",
  "permissions": ["storage", "alarms", "identity", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "https://*.googleapis.com/*",
    "https://accounts.google.com/*",
    "https://api.anthropic.com/*",
    "https://api.openai.com/*",

    "https://*/jobs/*",
    "https://*/job/*",
    "https://*/jobs/view/*",
